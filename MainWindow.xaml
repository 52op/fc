<Window x:Class="FC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FC.Controls"
        Title="FC - 磁盘目录分析迁移工具" Height="800" Width="1300"
        MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontSize="13"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style x:Key="GlyphText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- 菜单栏（按钮式，弹出程序化菜单） -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource MenuBarBrush}"
                BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="文件" Style="{StaticResource MenuBarButton}" Click="OnMenuFile" />
                <Button Content="扫描" Style="{StaticResource MenuBarButton}" Click="OnMenuScan" />
                <Button Content="视图" Style="{StaticResource MenuBarButton}" Click="OnMenuView" />
                <Button Content="设置" Style="{StaticResource MenuBarButton}" Click="OnMenuSettings" />
                <Button Content="帮助" Style="{StaticResource MenuBarButton}" Click="OnMenuHelp" />
            </StackPanel>
        </Border>

        <!-- 工具栏 -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <ComboBox Width="90" ItemsSource="{Binding Drives}"
                          SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                          ToolTip="盘符" />
                <Button Command="{Binding SelectFolderCommand}" ToolTip="选择要分析的目录" AutomationProperties.Name="选择目录">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource GlyphText}" />
                        <TextBlock Text="选择目录…" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ScanCommand}" ToolTip="扫描选中盘符/目录" AutomationProperties.Name="扫描">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource GlyphText}" />
                        <TextBlock Text="扫描" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CancelScanCommand}" ToolTip="停止扫描" AutomationProperties.Name="停止">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource GlyphText}" />
                        <TextBlock Text="停止" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ScanCommand}" ToolTip="重新扫描" AutomationProperties.Name="刷新">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource GlyphText}" />
                        <TextBlock Text="刷新" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ToggleButton Content="快速复用" IsChecked="{Binding QuickReuse, Mode=TwoWay}"
                              ToolTip="勾选后重扫复用上次扫描结果（未变目录免重算）。文件内容改动可能不体现，可取消勾选做完整扫描。" />
                <Separator />
                <ToggleButton Content="大小" IsChecked="{Binding ShowSizeColumn, Mode=TwoWay}" ToolTip="显示/隐藏 大小 列" />
                <ToggleButton Content="已分配" IsChecked="{Binding ShowAllocatedColumn, Mode=TwoWay}" ToolTip="显示/隐藏 已分配 列" />
                <ToggleButton Content="文件数" IsChecked="{Binding ShowFilesColumn, Mode=TwoWay}" />
                <ToggleButton Content="文件夹数" IsChecked="{Binding ShowFoldersColumn, Mode=TwoWay}" />
                <ToggleButton Content="百分比" IsChecked="{Binding ShowPercentColumn, Mode=TwoWay}" />
                <Separator />
                <TextBlock Text="单位:" VerticalAlignment="Center" Margin="2,0" />
                <ComboBox Width="76" ItemsSource="{Binding Units}"
                          SelectedItem="{Binding UnitMode, Mode=TwoWay}" />
                <Button Command="{Binding ExpandAllCommand}" ToolTip="展开全部目录" AutomationProperties.Name="展开全部">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE96E;" Style="{StaticResource GlyphText}" />
                        <TextBlock Text="展开全部" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CollapseAllCommand}" ToolTip="折叠全部目录" AutomationProperties.Name="折叠全部">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE96D;" Style="{StaticResource GlyphText}" />
                        <TextBlock Text="折叠全部" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Separator />
                <Button Command="{Binding OpenCleanupCommand}" ToolTip="一键清理建议（回收站/临时/缓存等，可真实执行清理）" AutomationProperties.Name="清理建议">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource GlyphText}" />
                        <TextBlock Text="清理建议" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowLargeFilesCommand}" ToolTip="全局最大的文件（来自最近一次扫描）" AutomationProperties.Name="最大文件">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource GlyphText}" />
                        <TextBlock Text="最大文件" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowTypeStatsCommand}" ToolTip="按文件类型聚合的占用统计" AutomationProperties.Name="类型统计">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B4;" Style="{StaticResource GlyphText}" />
                        <TextBlock Text="类型统计" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowDeltaCommand}" ToolTip="与上次扫描对比：哪些目录变化最大" AutomationProperties.Name="增量对比">
                    <TextBlock Text="增量对比" Margin="5,0,5,0" VerticalAlignment="Center" />
                </Button>
                <Separator />
                <Button Content="{Binding ThemeToggleText}" Command="{Binding ThemeToggleCommand}" ToolTip="切换深色/浅色主题" AutomationProperties.Name="主题切换" />
            </ToolBar>
        </ToolBarTray>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" MaxWidth="460" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding VolumeStatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding FilesStatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ExcludedStatusText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="200" Height="14" IsIndeterminate="True"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
            </StatusBarItem>
        </StatusBar>

        <!-- 树形表格 -->
        <local:TreeListView x:Name="TreeGrid" Margin="8,6,8,8" ItemsSource="{Binding Roots}" />
    </DockPanel>
</Window>