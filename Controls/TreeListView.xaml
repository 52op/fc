<UserControl x:Class="FC.Controls.TreeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FC.Controls"
             xmlns:conv="clr-namespace:FC.Converters"
             IsTabStop="False">
    <UserControl.Resources>
        <conv:ShowWidthConverter x:Key="ShowWidth" />
        <conv:SortArrowConverter x:Key="SortArrow" />

        <!-- 表头按钮 -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表头列宽拖动条 -->
        <Style x:Key="HeaderSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="4" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,1,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 数值单元格 -->
        <Style x:Key="NumCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="8,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 行样式 + TreeViewItem 模板 -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="打开"
                                  Visibility="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                  Command="{Binding PlacementTarget.DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="迁移此目录"
                                  Visibility="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}"
                                  Command="{Binding PlacementTarget.DataContext.MigrateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="打开所在目录"
                                  Command="{Binding PlacementTarget.DataContext.OpenExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="复制路径"
                                  Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="刷新此目录"
                                  Visibility="{Binding PlacementTarget.DataContext.IsFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}"
                                  Command="{Binding PlacementTarget.DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="Expander" Grid.Column="0"
                                          ClickMode="Press" Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Width="16" Height="16">
                                            <Path x:Name="Arrow" Data="M 4 3 L 11 8 L 4 13 Z"
                                                  Fill="{DynamicResource SecondaryTextBrush}"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="Bd" Grid.Column="1" Background="{TemplateBinding Background}"
                                    CornerRadius="3" Margin="0,1" Padding="0,1,4,1">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 占位子节点（仅为展开箭头）不显示 -->
                <DataTrigger Binding="{Binding IsDummy}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="4">
        <DockPanel>
            <!-- 表头：名称 | sp | 大小 | sp | 已分配 | sp | 文件数 | sp | 文件夹数 | sp | 百分比 | sp | 上次修改 -->
            <Grid x:Name="HeaderGrid" DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ColNameWidth, RelativeSource={RelativeSource AncestorType=local:TreeListView}}" />
                    <ColumnDefinition>
                        <ColumnDefinition.Width>
                            <MultiBinding Converter="{StaticResource ShowWidth}">
                                <Binding Path="DataContext.ShowSizeColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                <Binding Path="ColSplitterWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                            </MultiBinding>
                        </ColumnDefinition.Width>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Width>
                            <MultiBinding Converter="{StaticResource ShowWidth}">
                                <Binding Path="DataContext.ShowSizeColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                <Binding Path="ColSizeWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                            </MultiBinding>
                        </ColumnDefinition.Width>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Width>
                            <MultiBinding Converter="{StaticResource ShowWidth}">
                                <Binding Path="DataContext.ShowAllocatedColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                <Binding Path="ColSplitterWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                            </MultiBinding>
                        </ColumnDefinition.Width>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Width>
                            <MultiBinding Converter="{StaticResource ShowWidth}">
                                <Binding Path="DataContext.ShowAllocatedColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                <Binding Path="ColAllocatedWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                            </MultiBinding>
                        </ColumnDefinition.Width>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Width>
                            <MultiBinding Converter="{StaticResource ShowWidth}">
                                <Binding Path="DataContext.ShowFilesColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                <Binding Path="ColSplitterWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                            </MultiBinding>
                        </ColumnDefinition.Width>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Width>
                            <MultiBinding Converter="{StaticResource ShowWidth}">
                                <Binding Path="DataContext.ShowFilesColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                <Binding Path="ColFilesWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                            </MultiBinding>
                        </ColumnDefinition.Width>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Width>
                            <MultiBinding Converter="{StaticResource ShowWidth}">
                                <Binding Path="DataContext.ShowFoldersColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                <Binding Path="ColSplitterWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                            </MultiBinding>
                        </ColumnDefinition.Width>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Width>
                            <MultiBinding Converter="{StaticResource ShowWidth}">
                                <Binding Path="DataContext.ShowFoldersColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                <Binding Path="ColFoldersWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                            </MultiBinding>
                        </ColumnDefinition.Width>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Width>
                            <MultiBinding Converter="{StaticResource ShowWidth}">
                                <Binding Path="DataContext.ShowPercentColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                <Binding Path="ColSplitterWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                            </MultiBinding>
                        </ColumnDefinition.Width>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Width>
                            <MultiBinding Converter="{StaticResource ShowWidth}">
                                <Binding Path="DataContext.ShowPercentColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                <Binding Path="ColPercentWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                            </MultiBinding>
                        </ColumnDefinition.Width>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Width>
                            <MultiBinding Converter="{StaticResource ShowWidth}">
                                <Binding Path="DataContext.ShowPercentColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                <Binding Path="ColSplitterWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                            </MultiBinding>
                        </ColumnDefinition.Width>
                    </ColumnDefinition>
                    <ColumnDefinition Width="{Binding ColModifiedWidth, RelativeSource={RelativeSource AncestorType=local:TreeListView}}" />
                </Grid.ColumnDefinitions>

                <!-- 名称（0） -->
                <Button Grid.Column="0" Style="{StaticResource HeaderButton}"
                        Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="name">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="名称" FontWeight="SemiBold" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortArrow}">
                                    <Binding Path="DataContext.SortColumnKey" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding Path="DataContext.SortDescending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <GridSplitter Grid.Column="1" Style="{StaticResource HeaderSplitter}" />

                <!-- 大小（2） -->
                <Button Grid.Column="2" Style="{StaticResource HeaderButton}"
                        Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="size">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="大小" FontWeight="SemiBold" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortArrow}">
                                    <Binding Path="DataContext.SortColumnKey" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding Path="DataContext.SortDescending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <GridSplitter Grid.Column="3" Style="{StaticResource HeaderSplitter}" />

                <!-- 已分配（4） -->
                <Button Grid.Column="4" Style="{StaticResource HeaderButton}"
                        Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="allocated">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="已分配*" FontWeight="SemiBold" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortArrow}">
                                    <Binding Path="DataContext.SortColumnKey" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding Path="DataContext.SortDescending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <GridSplitter Grid.Column="5" Style="{StaticResource HeaderSplitter}" />

                <!-- 文件数（6） -->
                <Button Grid.Column="6" Style="{StaticResource HeaderButton}"
                        Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="files">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="文件数" FontWeight="SemiBold" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortArrow}">
                                    <Binding Path="DataContext.SortColumnKey" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding Path="DataContext.SortDescending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <GridSplitter Grid.Column="7" Style="{StaticResource HeaderSplitter}" />

                <!-- 文件夹数（8） -->
                <Button Grid.Column="8" Style="{StaticResource HeaderButton}"
                        Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="folders">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="文件夹数" FontWeight="SemiBold" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortArrow}">
                                    <Binding Path="DataContext.SortColumnKey" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding Path="DataContext.SortDescending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <GridSplitter Grid.Column="9" Style="{StaticResource HeaderSplitter}" />

                <!-- 占上一层 %（10） -->
                <Button Grid.Column="10" Style="{StaticResource HeaderButton}"
                        Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="percent"
                        ToolTip="扫描中 = 该目录计算进度（已完成子目录 N/M）；扫描完成后 = 占上一层比例">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="占上一层 %" FontWeight="SemiBold" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortArrow}">
                                    <Binding Path="DataContext.SortColumnKey" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding Path="DataContext.SortDescending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <GridSplitter Grid.Column="11" Style="{StaticResource HeaderSplitter}" />

                <!-- 上次修改（12） -->
                <Button Grid.Column="12" Style="{StaticResource HeaderButton}"
                        Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="modified">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="上次修改" FontWeight="SemiBold" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortArrow}">
                                    <Binding Path="DataContext.SortColumnKey" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding Path="DataContext.SortDescending" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 行 -->
            <TreeView x:Name="Tree"
                      ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=local:TreeListView}}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" BorderThickness="0" Padding="2">
                <TreeView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </TreeView.ItemsPanel>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ColNameWidth, RelativeSource={RelativeSource AncestorType=local:TreeListView}}" />
                                <ColumnDefinition>
                                    <ColumnDefinition.Width>
                                        <MultiBinding Converter="{StaticResource ShowWidth}">
                                            <Binding Path="DataContext.ShowSizeColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                            <Binding Path="ColSizeWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                        </MultiBinding>
                                    </ColumnDefinition.Width>
                                </ColumnDefinition>
                                <ColumnDefinition>
                                    <ColumnDefinition.Width>
                                        <MultiBinding Converter="{StaticResource ShowWidth}">
                                            <Binding Path="DataContext.ShowAllocatedColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                            <Binding Path="ColAllocatedWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                        </MultiBinding>
                                    </ColumnDefinition.Width>
                                </ColumnDefinition>
                                <ColumnDefinition>
                                    <ColumnDefinition.Width>
                                        <MultiBinding Converter="{StaticResource ShowWidth}">
                                            <Binding Path="DataContext.ShowFilesColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                            <Binding Path="ColFilesWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                        </MultiBinding>
                                    </ColumnDefinition.Width>
                                </ColumnDefinition>
                                <ColumnDefinition>
                                    <ColumnDefinition.Width>
                                        <MultiBinding Converter="{StaticResource ShowWidth}">
                                            <Binding Path="DataContext.ShowFoldersColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                            <Binding Path="ColFoldersWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                        </MultiBinding>
                                    </ColumnDefinition.Width>
                                </ColumnDefinition>
                                <ColumnDefinition>
                                    <ColumnDefinition.Width>
                                        <MultiBinding Converter="{StaticResource ShowWidth}">
                                            <Binding Path="DataContext.ShowPercentColumn" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                            <Binding Path="ColPercentWidth" RelativeSource="{RelativeSource AncestorType=local:TreeListView}" />
                                        </MultiBinding>
                                    </ColumnDefinition.Width>
                                </ColumnDefinition>
                                <ColumnDefinition Width="{Binding ColModifiedWidth, RelativeSource={RelativeSource AncestorType=local:TreeListView}}" />
                            </Grid.ColumnDefinitions>

                            <!-- 名称 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,1">
                                <Image Source="{Binding Icon}" Width="16" Height="16"
                                       VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock Text="{Binding HeaderText}" Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Text="{Binding FileTagText}" Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"
                                           Visibility="{Binding FileTagText, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource DangerBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"
                                           ToolTip="{Binding DetailText}" />
                            </StackPanel>

                            <!-- 大小 -->
                            <TextBlock Grid.Column="1" Style="{StaticResource NumCell}" Text="{Binding SizeDisplayText}" />

                            <!-- 已分配 -->
                            <TextBlock Grid.Column="2" Style="{StaticResource NumCell}" Text="{Binding AllocatedDisplayText}" />

                            <!-- 文件数 -->
                            <TextBlock Grid.Column="3" Style="{StaticResource NumCell}" Text="{Binding FileCountText}" />

                            <!-- 文件夹数 -->
                            <TextBlock Grid.Column="4" Style="{StaticResource NumCell}" Text="{Binding FolderCountText}" />

                            <!-- 占上一层 %（内嵌进度条） -->
                            <Grid Grid.Column="5" Margin="8,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding PercentText}"
                                           TextAlignment="Right" Width="46"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <Border Grid.Column="1" Width="90" Height="11" Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource BarTrackBrush}" CornerRadius="2">
                                    <Border Width="{Binding BarWidth}" HorizontalAlignment="Left"
                                            Background="{DynamicResource BarFillBrush}" CornerRadius="2" />
                                </Border>
                            </Grid>

                            <!-- 上次修改 -->
                            <TextBlock Grid.Column="6" Style="{StaticResource NumCell}" Text="{Binding LastWriteText}" />
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>
    </Border>
</UserControl>