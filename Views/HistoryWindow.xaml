<Window x:Class="FC.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FC - 查看迁移记录" Height="520" Width="980"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="刷新" Command="{Binding RefreshCommand}" Padding="12,4" />
            <Button Content="还原选中项" Command="{Binding RestoreCommand}" Padding="12,4" Margin="6,0,0,0" />
            <Button Content="删除记录" Command="{Binding DeleteCommand}" Padding="12,4" Margin="6,0,0,0" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="Gray" />
        </StackPanel>

        <DataGrid x:Name="Grid"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"
                  AlternatingRowBackground="#F4F6F8" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="源路径" Binding="{Binding SourcePath}" Width="2*" />
                <DataGridTextColumn Header="目标路径" Binding="{Binding DestPath}" Width="2*" />
                <DataGridTextColumn Header="大小" Binding="{Binding TotalBytes, Converter={StaticResource SizeTextConverter}}" Width="90" />
                <DataGridTextColumn Header="文件数" Binding="{Binding FileCount}" Width="70" />
                <DataGridTextColumn Header="迁移时间" Binding="{Binding MigratedAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="130" />
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" />
                <DataGridTextColumn Header="还原时间" Binding="{Binding RestoredAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="提示：还原操作会按顺序执行【删除源联接 → 重建空目录 → robocopy 拷回数据 → 校验 → 清理目标副本】。目标盘必须在线，否则无法还原。" />
    </DockPanel>
</Window>
