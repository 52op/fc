<Window x:Class="FC.Views.UpdateSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FC - 更新设置" Height="230" Width="520"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <StackPanel Margin="14">
        <TextBlock Text="规则数据更新地址" FontWeight="SemiBold" />
        <TextBlock Text="填写一个指向 envrules.xml 的 URL（留空则用 App.config 的 RulesUpdateUrl，都为空=不自动更新）。"
                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,6" />
        <TextBox x:Name="UrlBox" Height="26" VerticalContentAlignment="Center" Padding="4" />
        <TextBlock Text="该地址保存后，每次启动会静默尝试更新环境变量规则数据；也可在“帮助 → 更新 → 立即更新规则数据”手动触发。"
                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="80" Padding="0,6" Margin="0,0,8,0" Click="OnCancel" />
            <Button Content="保存" Width="80" Padding="0,6" FontWeight="SemiBold" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>