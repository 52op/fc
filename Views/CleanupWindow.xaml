<Window x:Class="FC.Views.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FC - 一键清理建议" Height="640" Width="860"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <DockPanel Margin="8">
        <!-- 顶部操作栏 -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="清理所选" Command="{Binding CleanCommand}" Padding="14,6"
                    FontWeight="SemiBold" />
            <Button Grid.Column="1" Content="刷新大小" Command="{Binding RefreshCommand}" Padding="14,6" Margin="6,0,0,0" />
            <Button Grid.Column="2" Content="取消" Command="{Binding CancelCommand}" Padding="14,6" Margin="6,0,0,0" />
            <TextBlock Grid.Column="3" Text="{Binding SelectedSummary}" Margin="14,0,0,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Margin="0,6,0,6"
                   Text="{Binding StatusText}" Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />

        <!-- 可清理项表格 -->
        <DataGrid x:Name="Grid"
                  AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                  ItemsSource="{Binding Items}" RowHeight="34">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="清理" Binding="{Binding Selected, Mode=TwoWay}"
                                        Width="56" IsThreeState="False" />
                <DataGridTextColumn Header="项目" Binding="{Binding Title}" Width="1.4*"
                                    IsReadOnly="True" />
                <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="2.6*"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="占用" Binding="{Binding SizeText}" Width="90"
                                    IsReadOnly="True" />
                <DataGridTextColumn Header="级别" Binding="{Binding SafetyText}" Width="60"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SafetyText}" Value="危险">
                                    <Setter Property="Foreground" Value="#E53935" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SafetyText}" Value="谨慎">
                                    <Setter Property="Foreground" Value="#F9A825" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SafetyText}" Value="安全">
                                    <Setter Property="Foreground" Value="#43A047" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 日志面板 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Margin="0,8,0,0" Background="{DynamicResource SurfaceBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="清理日志" Margin="8,5,0,3"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                <ListBox ItemsSource="{Binding Logs}" Margin="4" BorderThickness="0"
                         Background="Transparent" HorizontalContentAlignment="Stretch"
                         MaxHeight="150" FontFamily="Consolas" FontSize="11">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>