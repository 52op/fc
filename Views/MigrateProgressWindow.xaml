<Window x:Class="FC.Views.MigrateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FC.Converters"
        Title="FC - 迁移进度" Height="440" Width="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <conv:ProgressBarWidthConverter x:Key="ProgressBarWidth" />
        <!-- 显式自定义模板：Indicator 宽度直接绑定 Value，Value 一变条必然动 -->
        <Style x:Key="CreepProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="20" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root">
                            <Border Background="{DynamicResource BarTrackBrush}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource BarFillBrush}"
                                    CornerRadius="3">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ProgressBarWidth}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding ElementName="Root" Path="ActualWidth" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top"
                   FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6" />

        <DockPanel DockPanel.Dock="Bottom" LastChildFill="True">
            <Button x:Name="CancelButton" Content="取消" Width="90" Height="28"
                    DockPanel.Dock="Right" Click="OnCancelClicked" />
            <TextBlock x:Name="ValueText" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Margin="0,4,14,4" Foreground="{DynamicResource SecondaryTextBrush}" Text="0%" />
            <ProgressBar x:Name="ProgressBar" Style="{StaticResource CreepProgressBar}"
                         Value="0" HorizontalAlignment="Stretch" Margin="0,8,4,8" />
        </DockPanel>

        <TextBox x:Name="LogBox" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Microsoft YaHei" FontSize="12"
                 TextWrapping="NoWrap" AcceptsReturn="True"
                 Background="#F7F7F7" Margin="0,6,0,0" />
    </DockPanel>
</Window>