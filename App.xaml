<Application x:Class="FC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FC.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] 颜色字典固定位置：ThemeManager 切换主题时替换它 -->
                <ResourceDictionary Source="Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:SizeToTextConverter x:Key="SizeTextConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:CompareConverter x:Key="Compare" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>