<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- robocopy /MT 线程数 -->
        <add key="RobocopyThreads" value="16" />
        <!-- robocopy 失败重试次数 /R -->
        <add key="RobocopyRetries" value="2" />
        <!-- robocopy 重试间隔秒数 /W -->
        <add key="RobocopyWaitSeconds" value="2" />
        <!-- 扫描并行线程数（I/O 密集，SSD 可调大、HDD 调小） -->
        <add key="ScanThreads" value="32" />
        <!-- 排除目录名（逗号分隔，命中则跳过不扫描）。留空用默认列表 -->
        <add key="SkippedFolderNames" value="" />
    </appSettings>
</configuration>
